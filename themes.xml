<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.TelemetryOverlay" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/purple_500</item>
    </style>

    <style name="StatCell">
        <item name="android:orientation">vertical</item>
        <item name="android:layout_width">92dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">4dp</item>
    </style>

    <style name="StatLabel">
        <item name="android:textColor">@color/text_label</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="StatValue">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
